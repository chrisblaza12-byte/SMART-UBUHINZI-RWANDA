# Vite does not read a file named local.env automatically.
# Use .env.local instead. This file is only a reminder for teams that use
# the name "local.env" in other tools.

# Google Search Console HTML-tag verification value
VITE_GOOGLE_SITE_VERIFICATION=YOUR_SEARCH_CONSOLE_VERIFICATION_TOKEN
# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX